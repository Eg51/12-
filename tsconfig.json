{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "mongodb"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "app/lib/firebase.ts"
, "lib/firebase.ts", "./node_modules/@types", "lib/db.js", "lib/session.js", "lib/security.js", "lib/mongodb.js", "app/api/user/dashboard/route.js", "app/api/user/bills/route.js", "app/api/auth/login/route.js", "app/api/auth/register/route.js", "app/api/admin/users/route.js", "types/index.ts", "app/actions/getAdminUser.js"  ],
  "exclude": [
  ]
}